# GCC 14 built by Valve against the sniper baseline; see tools/NoslPilot/prepare_steam_sdk.sh.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
if(NOT STS2_STEAM_SDK)
  set(STS2_STEAM_SDK "$ENV{STS2_STEAM_SDK}")
endif()
if(NOT EXISTS "${STS2_STEAM_SDK}/usr/lib/gcc-14/bin/x86_64-linux-gnu-g++-14")
  message(FATAL_ERROR "Set STS2_STEAM_SDK to the sysroot prepared by tools/NoslPilot/prepare_steam_sdk.sh")
endif()
set(CMAKE_SYSROOT "${STS2_STEAM_SDK}")
set(CMAKE_CXX_COMPILER "${STS2_STEAM_SDK}/usr/lib/gcc-14/bin/x86_64-linux-gnu-g++-14")
# Valve's --with-gxx-include-dir is absolute and does not relocate with GCC.
set(_steam_cxx_headers "${STS2_STEAM_SDK}/usr/lib/gcc-14/x86_64-linux-gnu/include/c++/14")
set(CMAKE_CXX_FLAGS_INIT "-nostdinc++ -isystem \"${_steam_cxx_headers}\" -isystem \"${_steam_cxx_headers}/x86_64-linux-gnu\" -isystem \"${_steam_cxx_headers}/backward\"")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static-libstdc++ -static-libgcc")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-static-libstdc++ -static-libgcc")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES STS2_STEAM_SDK)
