<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Content exporter. Runs the shipped game assembly (sts2.dll) headless in a
    plain .NET process (no Godot engine), instantiates every model through
    ModelDb, and writes content.json for code generation.

    The game assemblies are referenced but not copied; Program.cs resolves them
    from the game's data directory at runtime (see the game-data option).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Sts2Headless/*.cs" LinkBase="Headless" />
  </ItemGroup>

  <ItemGroup>
    <None Include="native_getters.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(GameData)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameData)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameData)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
