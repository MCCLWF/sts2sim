<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
    <Upstream>$(MSBuildProjectDirectory)/../../../external/CombatSolver</Upstream>
    <Contracts>$(MSBuildProjectDirectory)/../../../artifacts/combatsolver-policy-oracle/contracts.cs</Contracts>
  </PropertyGroup>
  <ItemGroup>
    <!-- Full unmodified upstream files. The oracle does not reimplement comparisons. -->
    <Compile Include="$(Upstream)/src/Search/SolverWeights.cs" />
    <Compile Include="$(Upstream)/src/Search/SolverSearchProfile.cs" />
    <Compile Include="$(Upstream)/src/Search/SearchBudgetLedger.cs" />
    <Compile Include="$(Upstream)/src/Search/RouteQuality.cs" />
    <Compile Include="$(Upstream)/src/Search/RouteQualityPolicy.cs" />
    <Compile Include="$(Upstream)/src/Search/SolverInterimResultOrdering.cs" />
    <Compile Include="$(Upstream)/src/Search/ActEndingBossPolicy.cs" />
    <Compile Include="$(Upstream)/src/Search/PotionUsePolicy.cs" />
    <Compile Include="$(Upstream)/src/Search/TheftEncounterStrategy.cs" />
    <Compile Include="$(Upstream)/src/Search/CombatBeamSolver.Transpositions.cs" />
    <Compile Include="$(Contracts)" />
    <Reference Include="sts2" HintPath="$(GameData)/sts2.dll" />
    <Reference Include="GodotSharp" HintPath="$(GameData)/GodotSharp.dll" />
  </ItemGroup>
</Project>
