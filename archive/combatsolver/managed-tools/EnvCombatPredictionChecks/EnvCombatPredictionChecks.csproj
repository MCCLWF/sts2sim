<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <DerivedDll Condition="'$(DerivedDll)' == ''">$(MSBuildProjectDirectory)/../CombatSolverEnv/.godot/mono/temp/bin/Release/CombatSolverEnv.dll</DerivedDll>
    <RitsuWorkshopRoot Condition="'$(RitsuWorkshopRoot)' == ''">$(HOME)/snap/steam/common/.local/share/Steam/steamapps/workshop/content/2868840/3747602295</RitsuWorkshopRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Sts2Headless/*.cs" LinkBase="Headless" />
    <Compile Include="../Sts2Oracle/SingleThreadContext.cs" Link="SingleThreadContext.cs" />
    <Compile Include="../Sts2EnvCompare/Entry.cs" Link="Entry.cs" />
    <Compile Include="../CombatSolverEnv/Api/*.cs" Link="Api/%(Filename)%(Extension)" />
    <Compile Include="../CombatSolverEnv/Runtime/NativeCombatPrediction.cs" Link="NativeCombatPrediction.cs" />
    <Compile Include="../CombatSolverEnv/Runtime/EnvLiveCards.cs;../CombatSolverEnv/Runtime/EnvLiveMonsters.cs;../CombatSolverEnv/Runtime/EnvLiveRunContext.cs;../CombatSolverEnv/Runtime/EnvLiveCreatures.cs;../CombatSolverEnv/Runtime/EnvLiveInventory.cs;../CombatSolverEnv/Runtime/EnvLiveCombatContext.cs;../CombatSolverEnv/Runtime/EnvLiveRoomContext.cs;../CombatSolverEnv/Runtime/EnvLiveCollections.cs;../CombatSolverEnv/Runtime/EnvLiveRootAssembler.cs;../CombatSolverEnv/Runtime/EnvModelCatalog.cs" Link="Runtime/%(Filename)%(Extension)" />
    <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="all" />
    <Publicize Include="sts2" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
    <Publicize Include="CombatSolverEnv" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
    <Reference Include="CombatSolverEnv" HintPath="$(DerivedDll)" />
    <Reference Include="sts2" HintPath="$(GameData)/sts2.dll" />
    <Reference Include="GodotSharp" HintPath="$(GameData)/GodotSharp.dll" />
    <Reference Include="0Harmony" HintPath="$(GameData)/0Harmony.dll" />
    <AssemblyMetadata Include="RitsuCompatDirectory" Value="$(RitsuWorkshopRoot)/compat/0.111.0" />
    <AssemblyMetadata Include="RitsuSharedDirectory" Value="$(RitsuWorkshopRoot)/shared" />
  </ItemGroup>
  <Target Name="ValidateDerivedDll" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(DerivedDll)')" Text="Build tools/CombatSolverEnv -c Release first; terminal checks call its pinned upstream predictor." />
  </Target>
  <Target Name="PrepareCatalog" BeforeTargets="AssignTargetPaths;CoreCompile">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/../CombatSolverEnv/prepare_card_catalog.py&quot; &quot;$(MSBuildProjectDirectory)/../..&quot; &quot;$(IntermediateOutputPath)CardCatalog.g.json&quot;" />
    <ItemGroup><EmbeddedResource Include="$(IntermediateOutputPath)CardCatalog.g.json" LogicalName="CombatSolverEnv.CardCatalog.json" /></ItemGroup>
  </Target>
  <Target Name="CopyEnvLibrary" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../../build/libsts2env_c.so" DestinationFolder="$(TargetDir)" />
  </Target>
</Project>
