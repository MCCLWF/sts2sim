<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Sts2Dir Condition="'$(Sts2Dir)' == ''">$(HOME)/snap/steam/common/.local/share/Steam/steamapps/common/Slay the Spire 2</Sts2Dir>
    <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Dir)/data_sts2_linuxbsd_x86_64</Sts2DataDir>
    <ModOutputDir Condition="'$(ModOutputDir)' == ''">$(Sts2Dir)/mods/Sts2EnvCompare</ModOutputDir>
    <CopyModOnBuild Condition="'$(CopyModOnBuild)' == ''">false</CopyModOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2" HintPath="$(Sts2DataDir)/sts2.dll" Private="false" />
    <Reference Include="GodotSharp" HintPath="$(Sts2DataDir)/GodotSharp.dll" Private="false" />
  </ItemGroup>
  <Target Name="CopyComparisonMod" AfterTargets="Build" Condition="'$(CopyModOnBuild)' == 'true'">
    <MakeDir Directories="$(ModOutputDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModOutputDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/Sts2EnvCompare.json" DestinationFolder="$(ModOutputDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../../build/libsts2env_c.so" DestinationFolder="$(ModOutputDir)" />
  </Target>
</Project>
