<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Sts2Headless/*.cs" LinkBase="Headless" />
    <Compile Include="../CombatSolverEnv/Runtime/EnvLiveCreatures.cs" Link="EnvLiveCreatures.cs" />
    <Compile Include="../CombatSolverEnv/Runtime/EnvModelCatalog.cs" Link="EnvModelCatalog.cs" />
    <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="all" />
    <Publicize Include="sts2" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
    <Reference Include="sts2" HintPath="$(GameData)/sts2.dll" />
    <Reference Include="GodotSharp" HintPath="$(GameData)/GodotSharp.dll" />
    <Reference Include="0Harmony" HintPath="$(GameData)/0Harmony.dll" />
  </ItemGroup>
  <Target Name="PrepareCatalog" BeforeTargets="AssignTargetPaths;CoreCompile">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/../CombatSolverEnv/prepare_card_catalog.py&quot; &quot;$(MSBuildProjectDirectory)/../..&quot; &quot;$(IntermediateOutputPath)CardCatalog.g.json&quot;" />
    <ItemGroup><EmbeddedResource Include="$(IntermediateOutputPath)CardCatalog.g.json" LogicalName="CombatSolverEnv.CardCatalog.json" /></ItemGroup>
  </Target>
</Project>
